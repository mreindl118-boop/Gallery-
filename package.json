{
  "name": "gallerylab",
  "productName": "galleryLAB",
  "version": "0.1.0",
  "description": "A self-designing photography gallery",
  "author": "galleryLAB",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/libre-franklin": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "motion": "13.4.6",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "zustand": "5.0.15"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --composite false && tsc -p tsconfig.web.json --noEmit --composite false && tsc -p tsconfig.e2e.json --noEmit --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run test",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "dist:linux": "npm run build && electron-builder --linux dir",
    "postinstall": "electron-builder install-app-deps",
    "qa:shots": "npm run build && tsx scripts/qa-shots.ts"
  }
}
